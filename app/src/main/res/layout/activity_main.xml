<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ردیاب موقعیت با پیامک"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="۱) کلمه رمز را تنظیم کن. ۲) مجوزها را فعال کن. اگر گوشی گم شد، از هر شماره‌ای این کلمه را پیامک کن تا موقعیت GPS برایت برگردد."
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/editKeyword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="کلمه رمز (مثلا FINDME)" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ذخیره کلمه رمز" />

    <Button
        android:id="@+id/btnGrantPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="اعطای مجوزها (پیامک و مکان)" />

    <Button
        android:id="@+id/btnBackgroundLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="اجازه مکان در پس‌زمینه (Allow all the time)" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="14sp" />

</LinearLayout>
